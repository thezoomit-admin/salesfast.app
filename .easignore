# Same as .gitignore, but google-services.json IS uploaded to EAS
# so Android FCM / google-services plugin can resolve during cloud builds.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Keep google-services.json in the EAS archive (do not ignore it here)
# google-services.json

# FCM V1 service account private key: upload to Expo, never commit or bundle
fcm-service-account.json
*firebase-adminsdk*.json
