# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.keystore-export/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase (Android push) — upload as an EAS file env var instead
google-services.json

# Gradle build output of local native modules
modules/*/android/build/

# FCM V1 service account private key: upload to Expo, never commit or bundle
fcm-service-account.json
*firebase-adminsdk*.json
