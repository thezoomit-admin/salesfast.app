<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <!-- "Is this your lead?" prompt: phone-state broadcasts (number needs READ_CALL_LOG too). -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <!-- Optional: skip numbers saved in the user's contacts. Checked on the phone only. -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Exported so the system can deliver PHONE_STATE, a protected broadcast
         that only the system may send. -->
    <receiver
      android:name="expo.modules.androidcalllog.IncomingCallReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>
    <receiver
      android:name="expo.modules.androidcalllog.CallLeadActionReceiver"
      android:exported="false" />
  </application>
</manifest>
