<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.READ_CALL_LOG" />
  <!-- "Is this your lead?" prompt: phone-state broadcasts (number needs READ_CALL_LOG too). -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <!-- Optional: skip numbers saved in the user's contacts. Checked on the phone only. -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Lets the "Add as lead?" dialog appear over the lock screen / as a heads-up. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <!-- WhatsApp call tracking: see whether WhatsApp / WhatsApp Business is installed (Android 11+). -->
  <queries>
    <package android:name="com.whatsapp" />
    <package android:name="com.whatsapp.w4b" />
  </queries>

  <application>
    <!-- WhatsApp call tracking. Does nothing until the user grants
         Notification access to SalesFast and turns it on in Settings. It
         reads only WhatsApp call notifications; message text is never kept. -->
    <service
      android:name="expo.modules.androidcalllog.WhatsAppCallListener"
      android:label="SalesFast WhatsApp call tracking"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <!-- Exported so the system can deliver PHONE_STATE, a protected broadcast
         that only the system may send. -->
    <receiver
      android:name="expo.modules.androidcalllog.IncomingCallReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PHONE_STATE" />
      </intent-filter>
    </receiver>
    <receiver
      android:name="expo.modules.androidcalllog.CallLeadActionReceiver"
      android:exported="false" />
    <!-- Dialog popup for "Add as lead?" — opened via notification full-screen / tap. -->
    <activity
      android:name="expo.modules.androidcalllog.CallLeadAskActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:taskAffinity=""
      android:launchMode="singleInstance"
      android:theme="@android:style/Theme.Translucent.NoTitleBar"
      android:showWhenLocked="true"
      android:turnScreenOn="true" />
  </application>
</manifest>
