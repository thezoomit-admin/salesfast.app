# Local Expo Go / Metro only.
# Installed APKs ignore this file — EAS bakes staging:
#   https://salesfastapi-dev.thezoomit.com/api
#
# Keep localhost here — do not put a Wi‑Fi IP in this file.
# Expo Go swaps localhost for the PC's current IP automatically
# (src/constants/config.ts), so it works on any network.
# Do not delete this line: without it, app.config.ts falls back to staging.
EXPO_PUBLIC_API_URL=http://localhost:6001/api
